<!DOCTYPE html>
<html lang={assigns[:locale] || "en"} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Peredacha" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>

    <script>
      (function () {
        const getTheme = () => {
          const stored = localStorage.getItem("phx:theme") || "system";
          if (stored !== "system") return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        // Set initial theme immediately
        document.documentElement.dataset.theme = getTheme();

        // Listen for the theme change event
        window.addEventListener("phx:set-theme", (e) => {
          const value = e.detail.theme || e.detail; // Handle both formats
          localStorage.setItem("phx:theme", value);
          document.cookie = `theme=${value}; path=/; max-age=31536000; SameSite=Lax`;
          
          const resolved = value === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : value;
          document.documentElement.dataset.theme = resolved;
        });
      })()
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  </head>

  <body class="antialiased bg-base-100 text-base-content">
    {@inner_content}
    <script src="https://unpkg.com/aos@next/dist/aos.js">
    </script>

    <script>
      AOS.init({duration: 700, once: true});
    </script>
  </body>
</html>
